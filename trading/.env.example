# Copy this file to .env and fill in your Zerodha Kite Connect credentials.
# Never commit the real .env file.

KITE_API_KEY=your_api_key_here
KITE_API_SECRET=your_api_secret_here
# Access tokens expire every day at login-session reset. Generate a fresh one
# each morning with `python auth.py` and it will be written back here.
KITE_ACCESS_TOKEN=
